{
  "name": "@jobflow/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "models": ["dist/models/index.d.ts"],
      "models/*": ["dist/models/*"],
      "seed/*": ["dist/seed/*"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "require": "./dist/models/index.js",
      "import": "./dist/models/index.js",
      "default": "./dist/models/index.js"
    },
    "./seed/seedAutomationModules": {
      "types": "./dist/seed/seedAutomationModules.d.ts",
      "require": "./dist/seed/seedAutomationModules.js",
      "import": "./dist/seed/seedAutomationModules.js",
      "default": "./dist/seed/seedAutomationModules.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "seed:demo": "tsx src/seed/runDemoSeed.ts",
    "lint": "echo 'database lint placeholder'"
  },
  "dependencies": {
    "mongoose": "^8.19.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}

{
  "name": "@jobflow/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "schemas": ["./src/schemas/index.ts"],
      "schemas/*": ["./src/schemas/*.ts"],
      "constants/*": ["./src/constants/*.ts"],
      "types/*": ["./src/types/*.ts"],
      "utils/*": ["./src/utils/*.ts"],
      "env/*": ["./src/env/*.ts"],
      "*": ["./src/*.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "require": "./dist/types/*.js",
      "import": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    },
    "./constants/ai": {
      "types": "./src/constants/ai.ts",
      "require": "./dist/constants/ai.js",
      "import": "./dist/constants/ai.js"
    },
    "./constants/*": {
      "types": "./src/constants/*.ts",
      "require": "./dist/constants/*.js",
      "import": "./dist/constants/*.js"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "require": "./dist/utils/*.js",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "require": "./dist/schemas/index.js",
      "import": "./dist/schemas/index.js"
    },
    "./schemas/*": {
      "types": "./src/schemas/*.ts",
      "require": "./dist/schemas/*.js",
      "import": "./dist/schemas/*.js"
    },
    "./env/*": {
      "types": "./src/env/*.ts",
      "require": "./dist/env/*.js",
      "import": "./dist/env/*.js",
      "default": "./dist/env/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "lint": "echo 'shared lint placeholder'"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}

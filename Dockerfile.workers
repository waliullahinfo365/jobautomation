# Workers — Node 20, pnpm monorepo build
FROM node:20-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/workers ./apps/workers

RUN pnpm install --frozen-lockfile

# Install Playwright Chromium + OS dependencies
RUN npx playwright install chromium --with-deps

RUN pnpm --filter @jobflow/shared build \
  && pnpm --filter @jobflow/database build \
  && pnpm --filter @jobflow/integrations build \
  && pnpm --filter @jobflow/workers build

ENV NODE_ENV=production
WORKDIR /app/apps/workers
CMD ["node", "dist/index.js"]

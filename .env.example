# =============================================================================
# JobFlow — root environment (API + workers + shared tooling)
# Copy to `.env` locally. Do not commit real values.
# =============================================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
PORT=4000
LOG_LEVEL=info

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/jobflow-ai

# --- Auth ---
JWT_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=12345678901234567890123456789012
ALLOW_DEV_AUTH_HEADERS=true

# NextAuth (web only — if used)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Demo ---
DEMO_MODE_ENABLED=true
DEMO_TENANT_ID=demo-tenant-id
DEMO_USER_ID=demo-user-id

# --- Queue / Workers ---
QUEUE_MODE=memory
QUEUE_INLINE_EXECUTION=false
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Toronto
REDIS_URL=

# --- Google OAuth / Workspace ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback
GOOGLE_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
GOOGLE_REAL_API_ENABLED=false
GMAIL_WATCH_ENABLED=false
DRIVE_REAL_API_ENABLED=false
CALENDAR_REAL_API_ENABLED=false
GMAIL_JOB_QUERY=label:job-alerts

# --- AI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_REAL_API_ENABLED=false

# --- Billing / Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Public WEB app URL for Stripe checkout redirects (NOT the API URL)
WEB_APP_URL=https://newjob.guru
APP_BASE_URL=http://localhost:3000
# Stripe Price IDs from Dashboard → Products (EUR plans)
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_EXECUTIVE=
STRIPE_PRICE_EXECUTIVE_YEARLY=
STRIPE_PRICE_FOUNDING_PRO_YEARLY=
STRIPE_PRICE_AI_CREDITS_50=
STRIPE_PRICE_AI_CREDITS_150=
# Legacy aliases (optional)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_YEARLY=
# Set to true only in dev to bypass Stripe for POST /billing/change-plan
ALLOW_DIRECT_PLAN_CHANGE=false

# Comma-separated emails with full Owner access (super admins)
SUPER_ADMIN_EMAILS=info@benjaminkueper.com

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Frontend (used when running tooling from root; Next also reads apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_MOCK_FALLBACK=true
NEXT_PUBLIC_AUTH_TOKEN_KEY=jobflow_access_token
NEXT_PUBLIC_DEMO_TENANT_ID=demo-tenant-id
NEXT_PUBLIC_DEMO_USER_ID=demo-user-id

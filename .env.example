# =============================================================================
# JobFlow — root environment (API + workers + shared tooling)
# Copy to `.env` locally. Do not commit real values.
# =============================================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
PORT=4000
LOG_LEVEL=info

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/jobflow-ai

# --- Auth ---
JWT_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=12345678901234567890123456789012
ALLOW_DEV_AUTH_HEADERS=true

# NextAuth (web only — if used)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Demo ---
DEMO_MODE_ENABLED=true
DEMO_TENANT_ID=demo-tenant-id
DEMO_USER_ID=demo-user-id

# --- Queue / Workers ---
QUEUE_MODE=memory
QUEUE_INLINE_EXECUTION=false
SCHEDULER_ENABLED=false
# LinkedIn cloud Playwright auto-apply (Railway). Off by default — mobile users use Apply Assistant.
LINKEDIN_CLOUD_AUTO_APPLY_ENABLED=false
# Web UI: show desktop LinkedIn session card when true
NEXT_PUBLIC_LINKEDIN_CLOUD_AUTO_APPLY_ENABLED=false
SCHEDULER_TIMEZONE=America/Toronto
REDIS_URL=

# --- Google OAuth / Workspace ---
# Production example:
#   API_PUBLIC_URL=https://api.newjob.guru
#   GOOGLE_REDIRECT_URI=https://api.newjob.guru/integrations/google/callback
# Google Cloud Console: add api.newjob.guru + newjob.guru to authorized domains;
# redirect URIs: .../integrations/google/callback and .../auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback
GOOGLE_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
GOOGLE_REAL_API_ENABLED=false
GMAIL_WATCH_ENABLED=false
DRIVE_REAL_API_ENABLED=false
CALENDAR_REAL_API_ENABLED=false
# Gmail search for job intake. If label-only (e.g. label:job-alerts), sender-based OR clauses are added automatically so Stepstone, Indeed, Xing, etc. are still scanned.
GMAIL_JOB_QUERY=label:job-alerts

# --- AI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_REAL_API_ENABLED=false

# --- Billing / Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Public WEB app URL for Stripe checkout redirects (NOT the API URL)
WEB_APP_URL=https://newjob.guru
APP_BASE_URL=http://localhost:3000
# Stripe Price IDs from Dashboard → Products (EUR plans)
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_EXECUTIVE=
STRIPE_PRICE_EXECUTIVE_YEARLY=
STRIPE_PRICE_FOUNDING_PRO_YEARLY=
STRIPE_PRICE_AI_CREDITS_50=
STRIPE_PRICE_AI_CREDITS_150=
# Legacy aliases (optional)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_YEARLY=
# Set to true only in dev to bypass Stripe for POST /billing/change-plan
ALLOW_DIRECT_PLAN_CHANGE=false

# Comma-separated emails with full Owner access (super admins)
SUPER_ADMIN_EMAILS=info@benjaminkueper.com

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Web Push (API — lock-screen notifications for mobile PWA) ---
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@newjob.guru

# --- Firebase Storage (CV / cover letter binaries) ---
# Prefer env fields on Railway. Locally you can use FIREBASE_SERVICE_ACCOUNT_PATH instead.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccount.json

# --- Unipile (email intake — Gmail/Outlook via hosted auth) ---
UNIPILE_DSN=
UNIPILE_API_KEY=
# Optional: if outbound custom ports are blocked, set base DSN without port + UNIPILE_PORT
# UNIPILE_DSN=https://api59.unipile.com
# UNIPILE_PORT=12345
UNIPILE_EMAIL_INTAKE_ENABLED=true
# Optional shared secret for POST /integrations/unipile/webhook
UNIPILE_WEBHOOK_SECRET=

# Legacy Google paths (off by default — replaced by Firebase + Unipile)
# GOOGLE_DRIVE_ENABLED=true
# NEXT_PUBLIC_GOOGLE_DRIVE_ENABLED=true
# LEGACY_GMAIL_OAUTH_ENABLED=true
# NEXT_PUBLIC_LEGACY_GMAIL_OAUTH_ENABLED=true
# NEXT_PUBLIC_LEGACY_GMAIL_SCAN_ENABLED=true
# LEGACY_SMTP_ENABLED=true
# NEXT_PUBLIC_LEGACY_SMTP_ENABLED=true
# NOTION_LEGACY_ENABLED=true
# NEXT_PUBLIC_NOTION_LEGACY_ENABLED=true

# --- Frontend (used when running tooling from root; Next also reads apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_MOCK_FALLBACK=true
NEXT_PUBLIC_AUTH_TOKEN_KEY=jobflow_access_token
NEXT_PUBLIC_DEMO_TENANT_ID=demo-tenant-id
NEXT_PUBLIC_DEMO_USER_ID=demo-user-id

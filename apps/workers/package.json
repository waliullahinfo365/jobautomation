{
  "name": "@jobflow/workers",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "queue": ["./src/queues/automation.queue.ts"],
      "processors/folder-automation": ["./src/processors/folder-automation.processor.ts"],
      "processors/document-upload": ["./src/processors/document-upload.processor.ts"],
      "processors/job-intake": ["./src/processors/job-intake.processor.ts"],
      "processors/cv-routing": ["./src/processors/cv-routing.processor.ts"],
      "processors/interview-scheduling": ["./src/processors/interview-scheduling.processor.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./queue": {
      "types": "./src/queues/automation.queue.ts",
      "require": "./dist/queues/automation.queue.js",
      "import": "./dist/queues/automation.queue.js",
      "default": "./dist/queues/automation.queue.js"
    },
    "./processors/folder-automation": {
      "types": "./src/processors/folder-automation.processor.ts",
      "require": "./dist/processors/folder-automation.processor.js",
      "import": "./dist/processors/folder-automation.processor.js",
      "default": "./dist/processors/folder-automation.processor.js"
    },
    "./processors/document-upload": {
      "types": "./src/processors/document-upload.processor.ts",
      "require": "./dist/processors/document-upload.processor.js",
      "import": "./dist/processors/document-upload.processor.js",
      "default": "./dist/processors/document-upload.processor.js"
    },
    "./processors/job-intake": {
      "types": "./src/processors/job-intake.processor.ts",
      "require": "./dist/processors/job-intake.processor.js",
      "import": "./dist/processors/job-intake.processor.js",
      "default": "./dist/processors/job-intake.processor.js"
    },
    "./processors/cv-routing": {
      "types": "./src/processors/cv-routing.processor.ts",
      "require": "./dist/processors/cv-routing.processor.js",
      "import": "./dist/processors/cv-routing.processor.js",
      "default": "./dist/processors/cv-routing.processor.js"
    },
    "./processors/interview-scheduling": {
      "types": "./src/processors/interview-scheduling.processor.ts",
      "require": "./dist/processors/interview-scheduling.processor.js",
      "import": "./dist/processors/interview-scheduling.processor.js",
      "default": "./dist/processors/interview-scheduling.processor.js"
    },
    "./lib/google-auth": {
      "types": "./src/lib/google-auth.ts",
      "require": "./dist/lib/google-auth.js",
      "import": "./dist/lib/google-auth.js",
      "default": "./dist/lib/google-auth.js"
    },
    "./lib/workspace-profile-docs": {
      "types": "./src/lib/workspace-profile-docs.ts",
      "require": "./dist/lib/workspace-profile-docs.js",
      "import": "./dist/lib/workspace-profile-docs.js",
      "default": "./dist/lib/workspace-profile-docs.js"
    },
    "./processors/follow-up-reminder": {
      "types": "./src/processors/follow-up-reminder.processor.ts",
      "require": "./dist/processors/follow-up-reminder.processor.js",
      "import": "./dist/processors/follow-up-reminder.processor.js",
      "default": "./dist/processors/follow-up-reminder.processor.js"
    }
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "pnpm --filter @jobflow/integrations build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "echo 'workers lint placeholder'",
    "save-session": "dotenv -e ../../.env -- tsx src/cli/save-session.ts",
    "install-browsers": "playwright install chromium --with-deps"
  },
  "dependencies": {
    "@jobflow/database": "workspace:*",
    "@jobflow/integrations": "workspace:*",
    "@jobflow/shared": "workspace:*",
    "bullmq": "^5.76.5",
    "ioredis": "^5.10.1",
    "mongoose": "^8.19.2",
    "pino": "^9.14.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}

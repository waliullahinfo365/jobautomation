{
  "name": "@jobflow/workers",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "queue": [
        "dist/queues/automation.queue.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./queue": {
      "types": "./dist/queues/automation.queue.d.ts",
      "require": "./dist/queues/automation.queue.js",
      "import": "./dist/queues/automation.queue.js",
      "default": "./dist/queues/automation.queue.js"
    }
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "echo 'workers lint placeholder'"
  },
  "dependencies": {
    "@jobflow/database": "workspace:*",
    "@jobflow/shared": "workspace:*",
    "bullmq": "^5.76.5",
    "ioredis": "^5.10.1",
    "mongoose": "^8.19.2",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}

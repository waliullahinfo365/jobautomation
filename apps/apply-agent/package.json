{
  "name": "@jobflow/apply-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop Apply Agent — runs LinkedIn Easy Apply locally with your real IP",
  "bin": {
    "jobflow-apply-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@jobflow/integrations": "workspace:*",
    "@jobflow/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}

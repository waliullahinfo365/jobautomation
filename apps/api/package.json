{
  "name": "@jobflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "pnpm --filter @jobflow/integrations build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "echo 'api lint placeholder'"
  },
  "dependencies": {
    "@jobflow/database": "workspace:*",
    "@jobflow/integrations": "workspace:*",
    "@jobflow/shared": "workspace:*",
    "@jobflow/workers": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.0",
    "pino": "^9.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }

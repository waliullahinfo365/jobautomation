{
  "manifest_version": 3,
  "name": "NewJob Guru — LinkedIn Apply Assistant",
  "version": "0.1.0",
  "description": "Open Apply Assistant and detect LinkedIn Easy Apply jobs from your NewJob Guru account.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.linkedin.com/*", "https://*.newjob.guru/*", "http://localhost:3000/*"],
  "action": {
    "default_title": "NewJob Guru",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.jpeg"
  }
}
